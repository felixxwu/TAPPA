[gd_scene load_steps=2 format=3]

; THE FLAT SHELL — the game's main scene, and the only way into a run.
;
; It replaces the diegetic 3D hub (hq.tscn) and the overworld, both deleted in stage 2b of
; todo/roguelike-pivot-plan.md; decision 9 chose a flat 2D UI outright. All of the shell's
; behaviour lives in scripts/hub_shell.gd — this scene is deliberately just a full-rect
; Control for it to build pages under, because every page is created at runtime through
; MenuPage.open_modal rather than authored here. Read hub_shell.gd, not this file.

[ext_resource type="Script" path="res://scripts/hub_shell.gd" id="1_shell"]

[node name="Hub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shell")
