rules_version = '2';

// Firestore security rules for the TAPPA cloud save (project: tapparally).
//
// Kept in the repo, not just in the console, so a change to who can read a
// player's career shows up in a diff like any other change.
//
// The client's Firebase API key is public by design; THIS FILE is what actually
// protects the data. Every WRITABLE document is pinned to its owning uid, so a
// signed-in player can only ever write their own save and their own leaderboard
// entries, and nothing else in the database is reachable at all.
//
// One collection — stage_times — is world-READABLE, because a signed-out player
// has to be able to see a leaderboard. See the block below for why that is safe
// and what it costs.
//
// Anonymous ("guest") accounts get a real uid, so they are covered by the same
// rule with no special case.
//
// Deliberately NOT validated here: the contents of the profile blob. The client
// writes its own progress and there is no server-authoritative simulation to
// check it against, so a rule pretending to validate it would be security
// theatre. If cheating ever matters (leaderboards), the answer is a trusted
// server path for those specific values, not a stricter rule on this document.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Global per-stage leaderboards: one document per player per stage.
    //
    // THIS IS THE ONE WORLD-READABLE COLLECTION. A signed-out player must be
    // able to see the board, so `allow read: if true` is deliberate — and it is
    // what drives the document's shape. Everything in here is public forever to
    // anyone holding the (public) project id, so a row carries a chosen display
    // name and a car, and nothing else: no email, no profile data, no
    // uid-derived identity. The uid appears only as the document id, which is
    // already public in the same sense.
    //
    // hasOnly + hasAll together pin the document to exactly these five fields,
    // so a client cannot smuggle extra data into a public collection. The 24h
    // time cap is a shape guard against absurd values, not a balance figure.
    // updated_utc is length-capped but its format is NOT validated — nothing
    // branches on it, exactly as in the users document.
    //
    // `allow delete` is deliberately absent: a client cannot remove an entry,
    // its own or anyone else's. The improvement-only clause on update is a
    // BACKSTOP — the client already declines to write a slower time.
    match /stage_times/{stage}/times/{uid} {
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'car_name', 'car_id', 'time_ms', 'updated_utc'])
            && d.keys().hasAll(['name', 'car_name', 'car_id', 'time_ms', 'updated_utc'])
            && d.time_ms is int    && d.time_ms > 0 && d.time_ms < 86400000
            && d.name is string    && d.name.size() >= 1 && d.name.size() <= 16
            && d.car_name is string && d.car_name.size() <= 40
            && d.car_id is string   && d.car_id.size() <= 40
            && d.updated_utc is string && d.updated_utc.size() <= 32;
      }

      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validEntry();

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && validEntry()
                    && request.resource.data.time_ms < resource.data.time_ms;
    }

    // Daily / Weekly / Monthly Rally Challenge leaderboard: one document per
    // player per period, mirroring stage_times's trust model one level
    // deeper. World-readable, owner-only write, updated after every stage
    // (not just at the end) — see docs/superpowers/specs/
    // 2026-07-31-rally-challenge-design.md section 5 for the full rationale.
    //
    // Each cum_ms_N field is write-once (a stage's checkpoint, once posted,
    // never changes); dnf is the one field that is NOT write-once (it must
    // flip false -> true on a wreck), so it gets its own separate update
    // branch (isDnfFlip) rather than falling under the same "no field may
    // change" umbrella as the checkpoints.
    match /challenge_runs/{period_key}/entries/{uid} {
      // The legal stage count differs by challenge kind and can't be derived
      // from the collection path alone, so it's looked up from the kind
      // prefix embedded in period_key ("daily:" / "weekly:" / "monthly:").
      function maxStage(periodKey) {
        return periodKey.matches('^daily:.*') ? 1
             : periodKey.matches('^weekly:.*') ? 4
             : 10;
      }
      function checkpointField(k) {
        return 'cum_ms_' + string(k);
      }

      // CREATE: a document may only ever be born at stage 1.
      function isValidCreate() {
        let d = request.resource.data;
        return d.stages_completed == 1
            && d.dnf == false
            && d.cum_ms_1 is int && d.cum_ms_1 > 0 && d.cum_ms_1 < 86400000
            && d.keys().hasAll(['name', 'car_name', 'car_id', 'stages_completed', 'dnf', 'cum_ms_1'])
            && d.keys().hasOnly(['name', 'car_name', 'car_id', 'stages_completed', 'dnf', 'cum_ms_1'])
            && d.name is string    && d.name.size() >= 1 && d.name.size() <= 16
            && d.car_name is string && d.car_name.size() <= 40
            && d.car_id is string   && d.car_id.size() <= 40;
      }

      // UPDATE, path A: advancing exactly one checkpoint. Blocked once dnf is
      // true — a DNF'd run is over, no further checkpoint may ever be posted
      // to it. periodKey is passed in explicitly from the match block's own
      // path variable (a rules function has no implicit access to path
      // segments of its caller). Binding the new field's *name* to
      // `k = before.stages_completed + 1` (rather than trusting the client
      // to only ever touch "the next" key) is what closes the
      // checkpoint-skipping hole: affectedKeys().hasOnly([field,
      // 'stages_completed']) rejects any write that touches a cum_ms_*
      // field other than the one computed from the document's own current
      // stages_completed.
      //
      // `request.resource.data[field]`-style dynamic-key indexing on a
      // computed string is the one construct here that must be confirmed
      // against a live Firestore Rules emulator run before this ships — if
      // computed-key map indexing turns out to be unsupported, the fallback
      // is enumerating k in [1..10] as an explicit k == N ? ... : ... chain
      // instead of a function parameterized on k.
      function isStageAdvance(periodKey) {
        let before = resource.data;
        let after = request.resource.data;
        let k = before.stages_completed + 1;
        let field = checkpointField(k);
        return before.dnf == false
            && k <= maxStage(periodKey)
            && after.stages_completed == k
            && after.diff(before).affectedKeys().hasOnly([field, 'stages_completed'])
            && after[field] is int
            && after[field] > (k == 2 ? before.cum_ms_1 : before[checkpointField(k - 1)])
            && after[field] < 86400000 * k
            && after.dnf == before.dnf;
      }

      // UPDATE, path B: flipping dnf, and nothing else, at any point up to
      // and including the moment right after a checkpoint post (dnf still
      // false).
      function isDnfFlip() {
        let before = resource.data;
        let after = request.resource.data;
        return before.dnf == false && after.dnf == true
            && after.diff(before).affectedKeys().hasOnly(['dnf']);
      }

      allow read: if true;

      allow create: if request.auth.uid == uid && isValidCreate();

      allow update: if request.auth.uid == uid
                    && (isStageAdvance(period_key) || isDnfFlip());

      allow delete: if false;
    }

      function validState() {
        let d = request.resource.data;
        return d.keys().hasOnly(['round_index', 'started_at_ms'])
            && d.keys().hasAll(['round_index', 'started_at_ms'])
            && d.round_index is int && d.round_index >= 0
            && d.started_at_ms is int && d.started_at_ms > 0;
      }

      allow read: if true;

      allow create: if request.auth != null && validState();

      allow update: if request.auth != null
                    && validState()
                    && request.resource.data.round_index > resource.data.round_index;

      allow delete: if false;
    }

    // Everything else is closed. New collections must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
