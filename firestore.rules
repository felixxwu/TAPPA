rules_version = '2';

// Firestore security rules for the TAPPA cloud save (project: tapparally).
//
// Kept in the repo, not just in the console, so a change to who can read a
// player's career shows up in a diff like any other change.
//
// The client's Firebase API key is public by design; THIS FILE is what actually
// protects the data. Every WRITABLE document is pinned to its owning uid, so a
// signed-in player can only ever write their own save and their own leaderboard
// entries, and nothing else in the database is reachable at all.
//
// One collection — stage_times — is world-READABLE, because a signed-out player
// has to be able to see a leaderboard. See the block below for why that is safe
// and what it costs.
//
// Anonymous ("guest") accounts get a real uid, so they are covered by the same
// rule with no special case.
//
// Deliberately NOT validated here: the contents of the profile blob. The client
// writes its own progress and there is no server-authoritative simulation to
// check it against, so a rule pretending to validate it would be security
// theatre. If cheating ever matters (leaderboards), the answer is a trusted
// server path for those specific values, not a stricter rule on this document.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Global per-stage leaderboards: one document per player per stage.
    //
    // THIS IS THE ONE WORLD-READABLE COLLECTION. A signed-out player must be
    // able to see the board, so `allow read: if true` is deliberate — and it is
    // what drives the document's shape. Everything in here is public forever to
    // anyone holding the (public) project id, so a row carries a chosen display
    // name and a car, and nothing else: no email, no profile data, no
    // uid-derived identity. The uid appears only as the document id, which is
    // already public in the same sense.
    //
    // hasOnly + hasAll together pin the document to exactly these five fields,
    // so a client cannot smuggle extra data into a public collection. The 24h
    // time cap is a shape guard against absurd values, not a balance figure.
    // updated_utc is length-capped but its format is NOT validated — nothing
    // branches on it, exactly as in the users document.
    //
    // `allow delete` is deliberately absent: a client cannot remove an entry,
    // its own or anyone else's. The improvement-only clause on update is a
    // BACKSTOP — the client already declines to write a slower time.
    match /stage_times/{stage}/times/{uid} {
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'car_name', 'car_id', 'time_ms', 'updated_utc'])
            && d.keys().hasAll(['name', 'car_name', 'car_id', 'time_ms', 'updated_utc'])
            && d.time_ms is int    && d.time_ms > 0 && d.time_ms < 86400000
            && d.name is string    && d.name.size() >= 1 && d.name.size() <= 16
            && d.car_name is string && d.car_name.size() <= 40
            && d.car_id is string   && d.car_id.size() <= 40
            && d.updated_utc is string && d.updated_utc.size() <= 32;
      }

      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validEntry();

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && validEntry()
                    && request.resource.data.time_ms < resource.data.time_ms;
    }

    // Everything else is closed. New collections must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
