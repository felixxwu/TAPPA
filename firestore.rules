rules_version = '2';

// Firestore security rules for the TAPPA cloud save (project: tapparally).
//
// Kept in the repo, not just in the console, so a change to who can read a
// player's career shows up in a diff like any other change.
//
// The client's Firebase API key is public by design; THIS FILE is what actually
// protects the data. Every WRITABLE document is pinned to its owning uid, so a
// signed-in player can only ever write their own save, and nothing else in the database is reachable at all.
//
// The leaderboards that used to live here (stage_times, then the challenge_runs
// board) went with their features; only the per-player save remains.
//
// Anonymous ("guest") accounts get a real uid, so they are covered by the same
// rule with no special case.
//
// Deliberately NOT validated here: the contents of the profile blob. The client
// writes its own progress and there is no server-authoritative simulation to
// check it against, so a rule pretending to validate it would be security
// theatre. If cheating ever matters (leaderboards), the answer is a trusted
// server path for those specific values, not a stricter rule on this document.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed. New collections must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
